{
    "id": "codex-cli",
    "version": "1.0.1",
    "name": "Codex CLI",
    "documentationURL": "https://github.com/sekhar-isovalent/devcontainer-features/tree/main/src/codex-cli",
    "description": "Installs Codex CLI and the Codex VS Code extension.",
    "options": {
        "version": {
            "type": "string",
            "proposals": [
                "latest"
